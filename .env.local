# Public Supabase project values only. These are safe for browser use when RLS
# and Edge Function authorization are configured correctly.
VITE_SUPABASE_URL= ${{ secrets.VITE_SUPABASE_URL }}
VITE_SUPABASE_ANON_KEY= ${{ secrets.VIT_SUPABASE_ANON_KEY }}

# Never add a service-role key, Discord bot token, or FUSION_BOT_API_SECRET here.
